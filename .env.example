# --- Opción A: SQL Server local en Windows (autenticación de Windows, sin TCP) ---
DB_DRIVER=msnodesqlv8
DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=SubastasCopart;Trusted_Connection=yes;TrustServerCertificate=yes;

# --- Opción B: Azure SQL Database (usar en Azure App Service como "Variables de entorno") ---
# DB_SERVER=tu-servidor.database.windows.net
# DB_NAME=SubastasCopart
# DB_USER=tu_usuario
# DB_PASSWORD=tu_contraseña

JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
PORT=3000
